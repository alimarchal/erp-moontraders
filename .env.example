APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moontrader
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
USE_BATCH_EXPIRY=false
CLAIM_REGISTER_DATE_EDITABLE=true
SUPPLIER_LEDGER_DATE_EDITABLE=true

# Google Drive Backup
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER=moontraders-backups
BACKUP_NOTIFICATION_EMAIL="hello@example.com"

# Bank Statement Register: maker-checker limits (PKR). Entries below level 1 are posted by the maker,
# from level 1 a checker must approve, from level 2 a senior approver must approve as well.
BANK_MAKER_CHECKER_ENABLED=true
BANK_APPROVAL_LEVEL1_THRESHOLD=1000000
BANK_APPROVAL_LEVEL2_THRESHOLD=10000000
BANK_ALLOW_SELF_APPROVAL=false
BANK_APPROVAL_APPLIES_TO=both
BANK_APPROVAL_REQUIRED_FOR_REVERSAL=true
BANK_BULK_APPROVAL_MAX_ENTRIES=100

# =============================================================================
# FILE ATTACHMENTS (receipts, bills, slips, statements)
# =============================================================================
# Three modules keep uploaded files, and each one has its OWN switch. By default every one of them stores its
# files on this server (DISK=local). To move one module to Amazon S3, change only that module's DISK to s3 and
# fill in the AWS_* keys once (below). The other modules stay as they are.
#
#   DISK=local : files go to storage/app on this server. They are private: nobody can open one by a web address,
#                only a signed-in user with the right permission, through the application.
#   DISK=s3    : files go to your Amazon S3 bucket. Keep the bucket PRIVATE (block all public access). The IAM user
#                only needs s3:PutObject, s3:GetObject, s3:DeleteObject and s3:ListBucket on that bucket.
#                Downloads still go through the application's permission checks.
#
# The database never stores a file, only its path, name, type and size, so it stays small however many receipts
# are added. Changing a DISK later does NOT move files already stored: copy them first (for example
# `aws s3 sync storage/app s3://YOUR_BUCKET`), then switch the value.

# --- Amazon S3 credentials: needed only when at least one DISK below is s3 -------------------------------------
# Copy these lines, remove the leading "# " and fill in the values (the empty AWS_* keys near the top of this
# file are the same ones; set them in one place only).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# --- 1. Sales settlement: credit sales, recoveries, cheques, bank transfers, bank slips ---------------------------
# Stored under sales-settlement/<settlement no>/<section>/. ENABLED=false hides the upload fields (files are kept).
SETTLEMENT_ATTACHMENTS_ENABLED=true
SETTLEMENT_ATTACHMENTS_DISK=local
SETTLEMENT_ATTACHMENTS_MAX_KB=5120
# Make a file compulsory per section: with true, a settlement cannot be posted while any row of that section has
# no attachment (cash recoveries need none). false keeps it optional. Needs ENABLED=true. Posting and reversing a
# settlement work exactly as before; files are only checked, never changed, and a reversal leaves them untouched.
SS_CREDIT_SALES_DETAIL_ATTACHMENT=false
SS_RECOVERIES_DETAIL_ATTACHMENT=false
SS_CHEQUE_PAYMENTS_ATTACHMENT=false
SS_BANK_TRANSFERS_ATTACHMENT=false
SS_BANK_SLIPS_DEPOSITS_ATTACHMENT=false

# --- 2. Expense vouchers: receipts and bills, several per voucher ------------------------------------------------
# Stored under Vouchers/dd-mm-yyyy/. ENABLED=false hides the field (files are kept).
VOUCHER_ATTACHMENTS_ENABLED=true
VOUCHER_ATTACHMENTS_DISK=local
VOUCHER_ATTACHMENTS_MAX_KB=5120

# --- 3. Bank Statement Register: entry receipts, scanned receipts and imported statement files -------------------
# Stored under bank-attachments/<entry id>/, bank-receipt-scans/ and bank-statements/.
# Allowed types: pdf, jpg, jpeg, png, xlsx, xls, csv.
BANK_ATTACHMENT_DISK=local
BANK_ATTACHMENT_MAX_KB=10240

# --- Photo shrinking: applies to all three modules ---------------------------------------------------------------
# A phone photo of 5 MB usually becomes about 300 to 600 KB and is still easy to read. PDFs and spreadsheets are
# never changed. Set false to keep photos exactly as sent.
ATTACHMENT_IMAGE_OPTIMIZE=true
# Longest side of a stored photo, in pixels.
ATTACHMENT_IMAGE_MAX_PX=2000
# JPEG / WEBP quality, 1 to 100.
ATTACHMENT_IMAGE_QUALITY=82
# Photos smaller than this many KB (and within the pixel limit) are left exactly as they are.
ATTACHMENT_IMAGE_MIN_KB=300
